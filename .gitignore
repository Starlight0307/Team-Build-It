core/preference_memory.json
plugins/app_usage/

# 리마인더/조건부 알림(plugins/reminder.py)이 쌓는 이 사람 전용 타이머/조건/
# 자동실행 로그(action_log.jsonl 등) — plugins/system_history/와 같은 이유.
plugins/reminder/

# Agent 평가셋 실행 결과 — "소스"가 아니라 실행마다 쌓이는 artifact다(로컬
# PC 성능/Ollama 모델 버전/설치된 도구 목록 등 환경에 따라 값이 달라져서
# 그대로 공유하면 의미가 없다는 ChatGPT 검수 의견, 2026-09-23). 팀이 공유할
# 기준값이 필요하면 이 폴더가 아니라 별도 baseline 파일로 관리한다.
tests/agent/results/

# PC 상태 이력(plugins/system_history.py)이 1분마다 쌓는 이 PC 전용 CPU/RAM/디스크 기록
plugins/system_history/

# 환경설정(settings/app_settings.py) — 사람마다 다른 테마/음성 설정
settings/app_settings.json

# 🪄 스킬 화면에서 설치한 OpenClaw 스킬 (사람마다 다름 — core/skills.py)
skills/

# 회원별 개인화 저장소
